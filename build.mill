//| mill-version: 1.1.6
package build

import mill._
import mill.api.BuildCtx
import mill.scalalib._
import mill.scalalib.publish._
import mill.util.{JarManifest,Jvm}

import scala.annotation.tailrec

/*
 * This build supports the environment variable SOURCE_DATE_EPOCH for deterministic builds.
 * See https://reproducible-builds.org/docs/source-date-epoch/
 */

/**
  * What counts as part of c3p0, stated positively.
  *
  * Editors and tools leave files in the source tree: emacs backups and autosaves, vim swapfiles,
  * patch rejects, OS metadata. We cannot enumerate those completely. The list would be endless, it
  * differs with whoever is at the keyboard, and knowledge of any particular developer's tools has
  * no business in a shared build. Instead we say what c3p0's own files are, and eliminate a few
  * known, common patterns unlikely to be valid source or resource files. Only files that survive
  * both positive and negative criteria get treated as a build input. A stray Foo.java~ can neither
  * reach Maven Central nor provoke a needless regeneration, nor will most artifacts generated by
  * editors and other tooling.
  *
  * Adding a genuinely new kind of source or resource may require modifying the criteria for
  * recognizing valid inputs below.
  */
object ProjectFiles {
  /** javac compiles only these, and DebugGen reads the package structure from them */
  val SourceExtensions = Set("java")

  /** resources we ship on the classpath */
  val ResourceExtensions = Set("properties","txt")

  /** the input BeangenDataSourceGenerator consumes */
  val BeangenExtension = "beangen-xml"

  private def knownExcludable(p : os.Path) = p.last.startsWith("#") || p.last.startsWith(".#")

  def isSource( path : os.Path )       : Boolean = os.isFile(path) && !knownExcludable(path) && SourceExtensions( path.ext )
  def isResource( path : os.Path )     : Boolean = os.isFile(path) && !knownExcludable(path) && ResourceExtensions( path.ext )
  def isBeangenInput( path : os.Path ) : Boolean = os.isFile(path) && !knownExcludable(path) && path.ext == BeangenExtension
}

object Dependency {
  val MchangeCommonsJavaVersion = "0.6.1"
  val MchangeCommonsJava        = mvn"com.mchange:mchange-commons-java:${MchangeCommonsJavaVersion}"

  val JUnit  = mvn"org.junit.vintage:junit-vintage-engine:5.10.2"
  val PgJdbc = mvn"org.postgresql:postgresql:42.6.0"
  val Hsqldb = mvn"org.hsqldb:hsqldb:2.7.4"
}

object `package` extends JavaModule with SonatypeCentralPublishModule {

  val BuildJvmVersion = "11"

  val organization = "com.mchange"
  override def artifactName = Task {"c3p0"}

  override def publishVersion = Task {"0.15.0-pre1"}

  override def sonatypeCentralShouldRelease: T[Boolean] = Task { false }

  override def jvmVersion = BuildJvmVersion

  // we are currently building in Java 11, but releasing Java 7 compatible class files
  // for users of smaller JDBC subsets
  val JvmCompatVersion = "7"

  // we don't use the newer --release flag, we intentionally compile against newer API, so newer API is supported
  // but old JVMs that hit it wil generate NoSuchMethodError or similar at runtime
  override def javacOptions = Seq("-source",JvmCompatVersion,"-target",JvmCompatVersion)

  trait Gen extends JavaModule {
    /**
      * Resolves everything needed to run this module's generator main class, and yields a function
      * that runs it as a subprocess rooted at `destDir`, returning a PathRef to that directory.
      * (`destDir` is where generated output is rooted, not a file written to. Which files appear
      * beneath it is up to the generator and the mainArgs it is given.)
      *
      * Callers invoke this from an ordinary cached Task and hand the function that task's own
      * Task.dest (which is why it can't simply be baked in here: Task.dest is only available inside
      * the calling task's block). We deliberately do no staleness checking of our own. Whether a
      * generator re-runs is decided by mill, from the inputs the calling task declares — this
      * module's runClasspath, which covers the generator's own code and its module deps, plus
      * whatever Task.Sources the caller reads. And because destDir is a fresh, non-persistent
      * Task.dest, output generated for inputs that have since gone away cannot survive into a
      * later build.
      */
    def generator : Task[(os.Path, Seq[String]) => PathRef] = Task.Anon {
      val mainClass_   = finalMainClass()
      val classPath_   = runClasspath().map(_.path)
      val jvmArgs_     = forkArgs()
      val env_         = forkEnv() ++ build.sourceDateEpochEnv() // see sourceDateEpochEnv: the generators read this with System.getenv
      val useArgsFile_ = runUseArgsFile()
      (destDir : os.Path, args : Seq[String]) =>
        Jvm.callProcess(
          mainClass = mainClass_,
          classPath = classPath_,
          jvmArgs = jvmArgs_,
          env = env_,
          stdout = os.Inherit, // otherwise stuff printed to stdout gets captured in the never used CommandResult rather than streamed to the terminal as desired
          mainArgs = args,
          cwd = destDir,
          // cpPassingJarPath handling is modified from https://github.com/com-lihaoyi/mill/blob/06170d57a211430b63c383d9e627ffe4088649d6/libs/javalib/src/mill/javalib/RunModule.scala
          cpPassingJarPath = if useArgsFile_ then Some(os.temp(prefix = "gen-", suffix = ".jar", deleteOnExit = false)) else None
        )
        PathRef(destDir)
    }
    override def mvnDeps = Task {
      super.mvnDeps() ++ Seq(Dependency.MchangeCommonsJava)
    }
    // The generators stamp their banner comments with Date.toString(), which renders in the JVM's
    // default zone, so generated sources would otherwise differ between machines even with
    // SOURCE_DATE_EPOCH pinned (and TZ from the invoking shell does not reach a forked subprocess).
    // Unconditional rather than only-when-SOURCE_DATE_EPOCH, so ordinary and release builds agree.
    override def forkArgs = Task {
      Seq(
        "-Dcom.mchange.v2.log.MLog=com.mchange.v2.log.FallbackMLog",
        "-Duser.timezone=UTC"
      )
    }

    override def jvmVersion = BuildJvmVersion
  }

  object bean extends Gen {}

  // Unlike the other generators, this one has no sources of its own: DebugGen ships in
  // mchange-commons-java, which Gen already puts on the classpath. The module exists only to name
  // that main class and give it a runClasspath, so genDebugSources can fork it like any other
  // generator. Running it in-process instead would mean putting mchange-commons-java on the build
  // script's own classpath, which is what the mill-build meta-build used to be for.
  object debugGen extends Gen {
    override def mainClass = Task { Some("com.mchange.v2.debug.DebugGen") }
  }

  object beanInfo extends Gen {
    override def moduleDeps = Seq(build) // makes the c3p0 bean classes loadable at run time
    override def mainClass   = Task { Some("com.mchange.v2.c3p0.beaninfo.C3P0BeanInfoGen") }
  }

  object proxy extends Gen {
    override def sources = Task {
      super.sources() :+ build.proxyInterfaceSources()
    }
    override def mainClass = Task { Some("com.mchange.v2.c3p0.codegen.JdbcProxyGenerator") }
  }

  object beanInfoBin extends JavaModule {
    override def moduleDeps       = Seq(build) // compile BeanInfos against the beans
    override def javacOptions     = Seq("-source", JvmCompatVersion, "-target", JvmCompatVersion)
    override def sources          = Task { Seq.empty[PathRef] } // no hand-written sources
    override def generatedSources = Task { Seq(beanInfoGen()) }
    override def jvmVersion       = BuildJvmVersion
  }

  val Debug = true
  val Trace = 10     // 10 is TRACE_MAX, 5 for less tracing

  // Still very little evidence that there's any meaningful performance
  // gain statically dropping Debug code. Better to keep the often-very-useful
  // debug-level logging.
  //
  // val Debug = false
  // val Trace = 0

  val HandwrittenSourceDir = BuildCtx.workspaceRoot / "src"

  /**
    * The files that a generator scanning a directory actually depend on, as individual PathRefs
    * rather than one PathRef over the whole directory.
    *
    * A Task.Source over a directory hashes everything in it, so an editor backup written beside a
    * real source file changes the hash and re-runs the generator to produce byte-identical output.
    * Walking with a filter, in a Task.Input so the walk happens every build, means the recorded
    * input is exactly the set of project files: unchanged after filtering, no downstream work.
    *
    * Everything ignored is reported at warning level, because a file quietly being ignored is a
    * miserable thing to debug. If the allowlist in ProjectFiles ever needs widening, the warning is
    * what tells you so, rather than a generated class mysteriously failing to appear. It is also
    * meant to nag: the usual cure is to delete the junk it names.
    */
  // `warn` is taken as a plain function rather than reached via Task.log, because Task.* is usable
  // only directly inside a Task{...} block. Callers pass Task.log.warn from within theirs.
  def relevantFilesIn( codeGenerator : String )( dir : os.Path, warn : String => Unit )( keep : os.Path => Boolean ) : Seq[PathRef] = {
    if (os.exists(dir)) {
      val (kept, ignored) = os.walk(dir).filter( p => !os.isDir(p) ).sorted.partition( keep )
      val relDir          = dir.relativeTo( BuildCtx.workspaceRoot )
      ignored.foreach { p =>
        warn( s"${codeGenerator}: In directory '${relDir}', ignored file '${p.relativeTo(dir)}'." )
      }
      // the remedy, said once per directory rather than once per file
      ignored.size match {
        case 0 => ()
        case 1 => warn(s"If this file ought to be taken into account when deciding whether to re-run code generator '${codeGenerator}', modify ProjectFiles in build.mill to treat it as valid source.")
        case _ => warn(s"If any of these files ought to be taken into account when deciding whether to re-run code generator '${codeGenerator}', modify ProjectFiles in build.mill to treat them as valid source.")
      }
      kept.map( PathRef(_) )
    }
    else Nil
  }

  def debugGenSourceFiles : T[Seq[PathRef]] = Task.Input {
    relevantFilesIn("debugGen")( HandwrittenSourceDir, Task.log.warn )( ProjectFiles.isSource )
  }

  // shared by this module (which compiles these interfaces) and proxy (which generates against them).
  // Stays a directory Task.Source because mill's source handling wants source *directories*, and
  // compile is already immune to stray files -- mill's own allSourceFiles filters by extension.
  def proxyInterfaceSources : T[PathRef] = Task.Source( BuildCtx.workspaceRoot / "src-proxy-interface" )

  override def sources = Task {
    super.sources() :+ proxyInterfaceSources()
  }

  override def mvnDeps = Task {
    super.mvnDeps() ++ Seq(Dependency.MchangeCommonsJava)
  }

  // DebugGen emits one package-private Debug.java per package it finds beneath the codebase, so a
  // package added to or removed from src must re-run this, or the main compile fails on a missing
  // Debug symbol (or silently keeps a Debug class for a package that no longer exists).
  def genDebugSources = Task {
    val generate    = debugGen.generator()
    val sourceFiles = debugGenSourceFiles() // the filtered input that decides whether we re-run
    Task.log.debug( s"DebugGen scanning ${sourceFiles.size} java sources beneath ${HandwrittenSourceDir}" )
    generate(
      Task.dest,
      Seq("--packages=com.mchange",s"--codebase=${HandwrittenSourceDir}",s"--outputbase=${Task.dest}","--recursive",s"--debug=${Debug}",s"--trace=${Trace}")
    )
  }
  // TIMESTAMP falls back to wall-clock time, but this task only re-runs (and so only re-stamps)
  // when the version, the Debug/Trace constants, or SOURCE_DATE_EPOCH change — not on every build.
  // Set SOURCE_DATE_EPOCH for a reproducible timestamp.
  def genC3P0SubstitutionsSource : T[PathRef] = Task {
    import java.time.Instant
    val version   = publishVersion()
    val timestamp = sourceDateEpochMillis().map( Instant.ofEpochMilli ).getOrElse( Instant.now )
    val text =
      s"""|package com.mchange.v2.c3p0.subst;
          |
          |public final class C3P0Substitutions
          |{
          |    public final static String VERSION    = "${version}";
          |    public final static String DEBUG      = "${Debug}";
          |    public final static String TRACE      = "${Trace}";
          |    public final static String TIMESTAMP  = "${timestamp}";
          |
          |    private C3P0Substitutions()
          |    {}
          |}
          |""".stripMargin
    os.write( Task.dest / "com" / "mchange" / "v2" / "c3p0" / "subst" / "C3P0Substitutions.java", data = text, createFolders = true )
    PathRef(Task.dest)
  }

  val BeangenXmlDir = BuildCtx.workspaceRoot / "bean" / "beangen"

  def beangenXmlFiles : T[Seq[PathRef]] = Task.Input {
    relevantFilesIn("beangen")( BeangenXmlDir, Task.log.warn )( ProjectFiles.isBeangenInput )
  }

  def beangen : T[PathRef] = Task {
    val generate = bean.generator()
    val xmlFiles = beangenXmlFiles() // the filtered input that decides whether we re-run
    val inDir    = BeangenXmlDir / "com" / "mchange" / "v2" / "c3p0" / "impl"
    val outDir   = Task.dest / "com" / "mchange" / "v2" / "c3p0" / "impl"
    Task.log.debug( s"beangen reading ${xmlFiles.size} beangen-xml files beneath ${BeangenXmlDir}" )
    os.makeDir.all( outDir )
    generate( Task.dest, Seq( inDir.toString, outDir.toString ) )
  }

  val BeanInfoGenClasses = Seq(
    "com.mchange.v2.c3p0.DriverManagerDataSource",
    "com.mchange.v2.c3p0.PoolBackedDataSource",
    "com.mchange.v2.c3p0.ComboPooledDataSource",
    "com.mchange.v2.c3p0.WrapperConnectionPoolDataSource",
    "com.mchange.v2.c3p0.JndiRefConnectionPoolDataSource",
    "com.mchange.v2.c3p0.JndiRefForwardingDataSource",
    "com.mchange.v2.c3p0.debug.CloseLoggingComboPooledDataSource",
    "com.mchange.v2.c3p0.debug.ConstructionLoggingComboPooledDataSource",
    "com.mchange.v2.c3p0.debug.AfterCloseLoggingComboPooledDataSource",
    //"com.mchange.v2.c3p0.test.FreezableDriverManagerDataSource",
    //"com.mchange.v2.c3p0.test.AlwaysFailDataSource",
  )

  // C3P0BeanInfoGen reflects over the compiled beans, which it reaches via beanInfo's moduleDep on
  // this module. That dependency is what makes an edited beangen-xml (or any change to a bean class)
  // regenerate the BeanInfos, so it must not be short-circuited by any staleness check of our own.
  def beanInfoGen : T[PathRef] = Task {
    val generate = beanInfo.generator()
    generate( Task.dest, BeanInfoGenClasses :+ Task.dest.toString )
  }

  // The generated proxies mirror the java.sql interfaces of the JDK we generate under, so jvmVersion
  // is a genuine input here, not just a compile setting.
  def proxygen : T[PathRef] = Task {
    val generate = proxy.generator()
    Task.log.debug( s"Generating JDBC proxies against the java.sql interfaces of JVM ${proxy.jvmVersion()}" )
    generate( Task.dest, Seq( Task.dest.toString ) )
  }

  // note that beanInfoGen is NOT included here, because it must get built AFTER the root module
  // is built, requires code to be generated against reflection of the root build.
  override def generatedSources = Task {
    super.generatedSources() ++ Seq(genDebugSources(),genC3P0SubstitutionsSource(),beangen(),proxygen())
  }

  override def manifest = Task {
    val mainTups = JarManifest.MillDefault.main + Tuple2("Automatic-Module-Name","com.mchange.v2.c3p0")
    JarManifest( main = mainTups )
  }

  def allLicenses : T[Seq[PathRef]] = Task.Sources(
    BuildCtx.workspaceRoot / "LICENSE",
    BuildCtx.workspaceRoot / "LICENSE-LGPL",
    BuildCtx.workspaceRoot / "LICENSE-EPL"
  )

  // Task.env, not sys.env: sys.env inside a task is the environment of the long-lived mill daemon,
  // whatever that happened to be started with, so a shell-set SOURCE_DATE_EPOCH was silently ignored
  // unless the daemon happened to inherit it. Task.env is the invoking client's environment.
  def sourceDateEpochSeconds : T[Option[Long]] = Task.Input {
    Task.env.get("SOURCE_DATE_EPOCH").map( _.toLong )
  }

  // For reproducible builds: when SOURCE_DATE_EPOCH is set, stamp every jar entry with that fixed
  // time (Jvm.createJar leaves entry mtimes at wall-clock build time by default). Also the source of
  // the TIMESTAMP baked into C3P0Substitutions.
  def sourceDateEpochMillis : T[Option[Long]] = Task {
    sourceDateEpochSeconds().map( _ * 1000L )
  }

  // The mchange-commons-java code generators (DelegatorGenerator, SimplePropertyBeanGenerator,
  // BeanInfoGen) already honor SOURCE_DATE_EPOCH when they stamp the date into their banner comments
  // — but they read it from their own process environment with System.getenv, and mill's forkEnv is
  // built from the daemon's environment, which need not have it. So we pass it through explicitly,
  // or the generated sources (and hence the source jar) carry a wall-clock date and are not
  // reproducible even when SOURCE_DATE_EPOCH is set.
  def sourceDateEpochEnv : T[Map[String,String]] = Task {
    sourceDateEpochSeconds().map( secs => Map("SOURCE_DATE_EPOCH" -> secs.toString) ).getOrElse( Map.empty )
  }

  // Jvm.createJar honors its `timestamp` param for file/dir entries, but the META-INF/MANIFEST.MF
  // entry is written by the JarOutputStream(out, manifest) constructor and always gets wall-clock
  // time (verified unaddressed through mill 1.1.6). For reproducible builds we rewrite the finished
  // jar in place, forcing every entry's mtime to SOURCE_DATE_EPOCH. Entry content and order are
  // preserved; only mtimes change (a no-op for the already-correct entries). When SOURCE_DATE_EPOCH
  // is unset, millisOpt is None and the jar is left untouched. See https://reproducible-builds.org/docs/jvm/
  def normalizeJarEntryTimes( jar : os.Path, millisOpt : Option[Long] ) : Unit = 
    millisOpt.foreach { millis =>
      import java.util.zip.{ZipEntry, ZipInputStream, ZipOutputStream}
      import scala.util.Using
      val bo = new java.io.ByteArrayOutputStream()
      Using.resources(
        new ZipInputStream( new java.io.ByteArrayInputStream( os.read.bytes(jar) ) ),
        new ZipOutputStream( bo )
      ) { (in,out) =>
        var e = in.getNextEntry()
        while (e != null) {
          val ne = new ZipEntry( e.getName )
          ne.setTime( millis )
          out.putNextEntry( ne )
          out.write( in.readAllBytes() )
          out.closeEntry()
          e = in.getNextEntry()
        }
      }
      // write only after Using has closed the ZipOutputStream, so the central directory is flushed
      os.write.over( jar, bo.toByteArray() )
  }

  /**
    * Keeps files that are not ours out of a jar we publish.
    *
    * Jvm.createJar hands its fileFilter the input root along with the path relative to it, so we can
    * apply a different rule per kind of root rather than one blunt rule over everything. That matters:
    * an allowlist wide enough to be safe over compiler output would have to admit every extension
    * javac might emit, while a list narrow enough to be useful over a hand-maintained resources
    * directory would silently drop classes. So we only screen the roots where a person edits files,
    * and take compiler and generator output as given.
    */
  def jarFileFilter(jarLabel : String)( warn : String => Unit )( sourceRoots : Set[os.Path], resourceRoots : Set[os.Path] ) : (os.Path, os.RelPath) => Boolean =
    // relative to the workspace, to match how relevantFilesIn names directories. Generated roots
    // live under out/, so this stays readable for them too, and relativeTo yields '../' segments
    // rather than failing should a root ever lie outside the workspace.
    def relRoot( root : os.Path ) : os.RelPath = root.relativeTo( BuildCtx.workspaceRoot )
    def checkWarnSource( root : os.Path, rel : os.RelPath ) : Boolean =
      val out = ProjectFiles.isSource( root / rel )
      if !out then
        warn(s"When building ${jarLabel}, apparent source file '${rel}' from '${relRoot(root)}' was omitted. Modify ProjectFiles in build.mill to treat it as valid source if it should be included.")
      out
    def checkWarnResource( root : os.Path, rel : os.RelPath ) : Boolean =
      val out = ProjectFiles.isResource( root / rel )
      if !out then
        warn(s"When building ${jarLabel}, apparent resource '${rel}' from '${relRoot(root)}' was omitted. Modify ProjectFiles in build.mill to treat it as a valid resource if it should be included.")
      out
    (root, rel) =>
      if      ( os.isDir( root / rel ) ) true                             // keep the directory entries
      else if ( sourceRoots( root ) )    checkWarnSource(root,rel)
      else if ( resourceRoots( root ) )  checkWarnResource(root,rel)
      else                               true                             // compiled classes, generated sources, licenses

  // is the same manifest good?
  // some users want licenses in the source jars... https://github.com/swaldman/c3p0/issues/167
  //
  // Note that beanInfoGen() is not included in allSources() because it holds code that gets geerated AFTER the main
  // build taks has run. It does not generate source into the main build's generatedSources.
  // So we have to add it explicitly.
  def sourceJar: T[PathRef] = Task {
    val out           = Task.dest / "out.jar" // match the out.jar name produced by the default sourceJar task.
    val sourceRoots   = allSources().map(_.path).toSet
    val resourceRoots = (resources() ++ compileResources()).map(_.path).toSet
    Jvm.createJar(
      jar = out,
      inputPaths = (allSources() ++ resources() ++ compileResources() ++ Seq(beanInfoGen()) ++ allLicenses()).map(_.path).filter(os.exists),
      manifest = manifest(),
      fileFilter = jarFileFilter("source jar")(Task.log.warn)( sourceRoots, resourceRoots ),
      timestamp = sourceDateEpochMillis()
    )
    normalizeJarEntryTimes( out, sourceDateEpochMillis() )
    PathRef(out)
  }

  override def jar: T[PathRef] = Task {
    val out           = Task.dest / "out.jar" // match the out.jar name produced by the default jar task.
    val resourceRoots = resources().map(_.path).toSet
    Jvm.createJar(
      jar        = out,
      inputPaths = (Seq(compile().classes, beanInfoBin.compile().classes) ++ resources()).map(_.path).filter(os.exists),
      manifest   = manifest(),
      fileFilter = jarFileFilter("main (binary) jar")(Task.log.warn)( Set.empty, resourceRoots ), // no hand-edited source roots here, only compiler output and resources
      timestamp  = sourceDateEpochMillis()
    )
    normalizeJarEntryTimes( out, sourceDateEpochMillis() )
    PathRef(out)
  }

  object doc extends JavaModule
  {
    val StagingDir = os.Path("/Users/swaldman/development/gitproj/www.mchange.com/projects/c3p0-versions")

    def replacements : T[Map[String,String]] = Task {
        import java.time.ZonedDateTime
        Map(
          "@c3p0.version@" -> build.publishVersion(),
          "@mchange-commons-java.version@" -> Dependency.MchangeCommonsJavaVersion,
          "@c3p0.copyright.year@" -> ZonedDateTime.now().getYear.toString
        );
    }

    @tailrec
    def replaceAll( replacements : List[(String,String)], template : String ) : String = {
      replacements match {
        case head :: tail => replaceAll(tail, template.replace(head._1, head._2))
        case Nil          => template
      }
    }

    def docsrc : T[PathRef] = Task.Source { moduleDir / "docsrc" }

    def docroot : T[PathRef] = Task {
      val javadocRoot = build.javadocGenerated().path // build.docJar().path / os.up / "javadoc"
      val replaceMap = replacements()
      val docsrcDir = docsrc().path
      val sourcePaths = os.walk(docsrcDir)
      def destPath( sourcePath : os.Path ) = Task.dest / sourcePath.relativeTo(docsrcDir)
      sourcePaths.foreach { sp =>
        if (sp.toString.endsWith(".html")) {
          val replaced = replaceAll( replaceMap.toList, os.read(sp) )
          os.write(destPath(sp), replaced)
        }
        else
          os.copy.over( from=sp, to=destPath(sp) )
      }
      os.copy.over( from = javadocRoot, to = Task.dest / "apidocs" )
      PathRef(Task.dest)
    }

    def stage : T[Unit] = Task {
      os.copy.over( from = docroot().path, to = StagingDir / ("c3p0-" + build.publishVersion()) )
    }
  }

  // for now at least, I don't mean to publish tests as a public library,
  // but I do want to publish them locally so I have them when working on related
  // libraries
  object test extends JavaModule with TestModule.Junit5 with PublishModule {

    override def moduleDeps = Seq(build)

    override def artifactName = Task {"c3p0-test"}
    override def publishVersion = Task { build.publishVersion() }

    // when you want to generate tests you can try under old JVMs
    override def javacOptions = Seq("-source",JvmCompatVersion,"-target",JvmCompatVersion)

    override def jvmVersion = BuildJvmVersion

    def testParallelism = false

    /**
      * How a test run is configured, read from the environment rather than by editing this file.
      * Everything here affects only how tests are run, never what is compiled or published, so
      * switching setups costs nothing and rebuilds nothing.
      *
      *   C3P0_TEST_CONFIG    "local" (the default) or "rough", selecting which c3p0.properties
      *                       the tests see -- see localResources / localResourcesRough below
      *   C3P0_TEST_JDBC_URL  overrides the default postgres URL
      *   C3P0_TEST_USER      sets -Dc3p0.user, when present
      *   C3P0_TEST_PASSWORD  sets -Dc3p0.password, when present (may be empty, as hsqldb wants)
      *   C3P0_TEST_JVM_ARGS  whitespace-separated extra JVM args, appended last
      *
      * So, for example:
      *
      *   C3P0_TEST_CONFIG=rough mill test.c3p0Load
      *   C3P0_TEST_JVM_ARGS='-ea -Dc3p0.maxStatements=100' mill test.c3p0PSLoad
      *
      * One switch deliberately remains a source edit: running against hsqldb also needs its driver
      * on the classpath, and this module is published, so an env-conditional mvnDeps would make the
      * published pom depend on the environment it was published from. Uncomment Dependency.Hsqldb
      * in mvnDeps below, then set C3P0_TEST_JDBC_URL, C3P0_TEST_USER and C3P0_TEST_PASSWORD.
      */
    def testEnv : T[Map[String,String]] = Task.Input {
      Task.env.filter { case (k,_) => k.startsWith("C3P0_TEST_") }
    }

    /**
      * A place for resources we want seen by local (test) runs, but
      * should not be published (even locally) into the c3p0-test jar,
      * so that when we run tests from elsewhere, they are not polluted
      * by settings in these resources
      *
      * We maintain two sets of configs for quick tests, one "reasonable", the other intentionally
      * miserable. We tend to run tests against both, selected by C3P0_TEST_CONFIG.
      */
    def localResources : T[PathRef] = Task.Source { moduleDir / "resources-local" }
    def localResourcesRough : T[PathRef] = Task.Source { moduleDir / "resources-local-rough" }

    def selectedLocalResources : T[PathRef] = Task {
      testEnv().get("C3P0_TEST_CONFIG").map( _.toLowerCase ) match {
        case None | Some("local") => localResources()
        case Some("rough")        => localResourcesRough()
        case Some( bad )          => sys.error(s"C3P0_TEST_CONFIG must be 'local' or 'rough', found '${bad}'.")
      }
    }

    override def runClasspath : T[Seq[PathRef]] = Task {
      // build.beanInfoBin holds the generated explicit BeanInfo classes, which ship in the
      // main jar but are not part of build.compile (so not pulled in via the moduleDep on build).
      // We add them here so java.beans.Introspector finds them at test runtime, as it would in a
      // deployed jar. (See PerishableConnectionResourcesNotBeanPropertiesJUnitTestCase.)
      val testClasses = super.runClasspath() :+ build.beanInfoBin.compile().classes

      testClasses :+ selectedLocalResources()
    }

    def externalClassPath : T[String] = Task {
      val sep = java.io.File.pathSeparator
      runClasspath().map( _.path ).mkString( sep )
    }

    def externalForkArgs : T[String] = Task {
      forkArgs().mkString(" ")
    }

    def externalCommandBase : T[String] = Task[String] {
       List("java",externalForkArgs(),"-cp",externalClassPath()).mkString(" ")
    }

    def printExternalCommandBase : T[Unit] = Task {
      println(externalCommandBase())
    }

    override def mvnDeps = Task {
      super.mvnDeps() ++ Seq(
        Dependency.JUnit,
        Dependency.PgJdbc,
        //Dependency.Hsqldb
      )
    }
    val DefaultTestJdbcUrl = "jdbc:postgresql://localhost:5432/c3p0"

    // Everything that used to sit here commented-out, waiting to be switched on by hand, now goes
    // through the environment. Some that were worth keeping a record of:
    //
    //   hsqldb        C3P0_TEST_JDBC_URL='jdbc:hsqldb:hsql://localhost/mydb;hsqldb.sqllog=3'
    //                 C3P0_TEST_USER=SA C3P0_TEST_PASSWORD=
    //                 (plus uncommenting Dependency.Hsqldb above -- see testEnv)
    //   statements    C3P0_TEST_JVM_ARGS='-Dc3p0.maxStatements=100 -Dc3p0.maxStatementsPerConnection=5'
    //                 C3P0_TEST_JVM_ARGS='-Dc3p0.cancelAutomaticallyClosedStatements=true'
    //   jmx           C3P0_TEST_JVM_ARGS='-Dcom.sun.management.jmxremote.port=38383
    //                   -Dcom.sun.management.jmxremote.authenticate=false
    //                   -Dcom.sun.management.jmxremote.ssl=false'
    //   profiling     C3P0_TEST_JVM_ARGS='-Xrunhprof:cpu=times,file=/tmp/java.hprof,doe=y,format=a'
    //   misc          C3P0_TEST_JVM_ARGS='-server -ea -verbose:class -XX:MaxJavaStackTraceDepth=0'
    override def forkArgs = Task {
      val env         = testEnv()
      val jdbcUrl     = env.getOrElse("C3P0_TEST_JDBC_URL", DefaultTestJdbcUrl)
      val credentials = env.get("C3P0_TEST_USER").map( u => s"-Dc3p0.user=${u}" ) ++
                        env.get("C3P0_TEST_PASSWORD").map( p => s"-Dc3p0.password=${p}" )
      val extraArgs   = env.get("C3P0_TEST_JVM_ARGS").toSeq.flatMap( _.split("\\s+") ).filter( _.nonEmpty )
      Seq(
        s"-Dc3p0.jdbcUrl=${jdbcUrl}",
        "-Djava.rmi.server.hostname=localhost",
        s"""-Djava.util.logging.config.file=${moduleDir / "conf-logging" / "logging.properties"}"""
      ) ++ credentials ++ extraArgs
    }
    def c3p0Benchmark() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.C3P0BenchmarkApp")()
    }
    def c3p0Stats() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.StatsTest")()
    }
    def c3p0Proxywrapper() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.ProxyWrappersTest")()
    }
    def c3p0RawConnectionOp() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.RawConnectionOpTest")()
    }
    def c3p0Load() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.LoadPoolBackedDataSource")()
    }
    def c3p0PSLoad() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.PSLoadPoolBackedDataSource")()
    }
    def c3p0InterruptedBatch() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.InterruptedBatchTest")()
    }
    def c3p0Dispersion() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.ConnectionDispersionTest")()
    }
    def c3p0OneThreadRepeat() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.OneThreadRepeatedInsertOrQueryTest")()
    }
    def c3p0RefSer() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.TestRefSerStuff")()
    }
    def c3p0JavaBeanRef() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.JavaBeanRefTest")()
    }
    def c3p0DynamicPreparedStatement() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.DynamicPreparedStatementTest")()
    }
    def c3p0StatementState() = Task.Command {
      this.runMain("com.mchange.v2.c3p0.test.StatementStateTest")()
    }
    override def pomSettings = Task {
      PomSettings(
        description = "Tests of c3p0, a mature JDBC3+ Connection pooling library",
        organization = organization,
        url = "https://www.mchange.com/projects/c3p0",
        licenses = Seq(License.`LGPL-2.1-or-later`,License.`EPL-1.0`),
        versionControl = VersionControl.github("swaldman", "c3p0"),
        developers = Seq(
          Developer("swaldman", "Steve Waldman", "https://github.com/swaldman")
        )
      )
    }

    // just to give ourselves the command `$ mill -i test.scalamod.console`
    object scalamod extends ScalaModule {
      override def moduleDeps = Seq(build.test)
      override def scalaVersion = "3.3.7"
      override def runClasspath = Task { build.test.runClasspath() }
      override def forkArgs = Task { build.test.forkArgs() }
    }
  }

  override def pomSettings = Task {
    PomSettings(
      description = "A mature JDBC3+ Connection pooling library",
      organization = organization,
      url = "https://www.mchange.com/projects/c3p0",
      licenses = Seq(License.`LGPL-2.1-or-later`,License.`EPL-1.0`),
      versionControl = VersionControl.github("swaldman", "c3p0"),
      developers = Seq(
        Developer("swaldman", "Steve Waldman", "https://github.com/swaldman")
      )
    )
  }

  // intended to publish development snapshots, not for stable releases
  val MchangeStaging = "/Users/swaldman/development/gitproj/www.mchange.com/repository"

  def publishMchange() = this.publishM2Local( MchangeStaging )
}
